# Fail install if engines in package.json are unmet (when engines is set)
engine-strict=true

# Block dependency lifecycle scripts by default (mitigate malicious postinstall)
ignore-scripts=true

# Ignore package versions published within the last N days (cooldown for fresh compromises)
min-release-age=7

# Disallow git/http dependency URLs that can bypass registry controls (npm 11.10+)
allow-git=none
