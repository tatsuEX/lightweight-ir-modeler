{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://lightweight-ir-modeler.local/schemas/raw/im-forma.schema.json",
	"title": "IM-Forma RawDefinition",
	"type": "object",
	"additionalProperties": true,
	"required": ["target", "logicalId", "name", "items"],
	"properties": {
		"target": {
			"const": "im-forma"
		},
		"logicalId": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"version": {
			"type": "string"
		},
		"items": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/item"
			}
		}
	},
	"$defs": {
		"item": {
			"type": "object",
			"additionalProperties": true,
			"required": ["type"],
			"properties": {
				"type": {
					"type": "string",
					"minLength": 1
				},
				"logicalId": {
					"type": "string"
				},
				"label": {
					"type": "string"
				},
				"hint": {
					"type": "string"
				},
				"required": {
					"type": "boolean"
				},
				"disabled": {
					"type": "boolean"
				},
				"readonly": {
					"type": "boolean"
				},
				"hidden": {
					"type": "boolean"
				},
				"validation": {
					"type": "object",
					"additionalProperties": true
				}
			}
		}
	}
}
