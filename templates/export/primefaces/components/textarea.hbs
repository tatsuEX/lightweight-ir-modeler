<p:inputTextarea
	id="{{id}}"
	{{#if required}}required="true"{{/if}}
	{{#if hint}}placeholder="{{hint}}"{{/if}}
	{{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
	{{#if disabled}}disabled="true"{{/if}}
	{{#if readonly}}readonly="true"{{/if}}
	{{#if cols}}cols="{{cols}}"{{/if}}
	{{#if rows}}rows="{{rows}}"{{/if}}
	></p:inputTextarea>
